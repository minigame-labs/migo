{
  "$id": "https://migo.dev/contracts/artifact-manifest/v8-component-schema-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "component_id": {
      "$ref": "schema-v1.json#/$defs/sha256"
    },
    "hashes": {
      "additionalProperties": false,
      "properties": {
        "archive": {
          "$ref": "schema-v1.json#/$defs/sha256"
        },
        "rust_binding": {
          "$ref": "schema-v1.json#/$defs/sha256"
        }
      },
      "required": [
        "archive",
        "rust_binding"
      ],
      "type": "object"
    },
    "provenance": {
      "$ref": "schema-v1.json#/$defs/provenance"
    },
    "runtime": {
      "$ref": "schema-v1.json#/$defs/v8Runtime"
    },
    "schema": {
      "const": "migo-v8-component-manifest/v1"
    },
    "target": {
      "oneOf": [
        {
          "$ref": "schema-v1.json#/$defs/androidTarget"
        },
        {
          "$ref": "schema-v1.json#/$defs/appleV8Target"
        },
        {
          "$ref": "schema-v1.json#/$defs/linuxV8Target"
        },
        {
          "$ref": "schema-v1.json#/$defs/ohosV8Target"
        },
        {
          "$ref": "schema-v1.json#/$defs/windowsV8Target"
        }
      ]
    },
    "toolchain": {
      "$ref": "schema-v1.json#/$defs/toolchain"
    }
  },
  "required": [
    "schema",
    "component_id",
    "target",
    "toolchain",
    "runtime",
    "hashes",
    "provenance"
  ],
  "title": "Migo V8 component manifest v1",
  "type": "object"
}
