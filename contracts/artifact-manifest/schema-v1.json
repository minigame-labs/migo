{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migo.dev/contracts/artifact-manifest/schema-v1.json",
  "title": "Migo Android artifact slice manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "product_profile",
    "build_type",
    "codegen_profile",
    "target",
    "toolchain",
    "runtime",
    "snapshots",
    "graphics",
    "hashes",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "migo-artifact-manifest/v1" },
    "artifact_id": { "$ref": "#/$defs/sha256" },
    "product_profile": { "enum": ["full", "slim"] },
    "build_type": { "enum": ["debug", "release"] },
    "codegen_profile": { "enum": ["z", "2", "3"] },
    "target": { "$ref": "#/$defs/androidTarget" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "runtime": { "$ref": "#/$defs/v8Runtime" },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/snapshot" }
    },
    "graphics": { "$ref": "#/$defs/graphics" },
    "hashes": { "$ref": "#/$defs/artifactHashes" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "nonPlaceholder": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["unknown", "UNKNOWN", "unset", "UNSET"] }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "androidTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["triple", "os", "arch", "abi", "cpu_baseline", "required_cpu_features", "runtime_floor"],
          "properties": {
            "triple": { "const": "aarch64-linux-android" },
            "os": { "const": "android" },
            "arch": { "const": "aarch64" },
            "abi": { "const": "android" },
            "cpu_baseline": { "const": "armv8-a" },
            "required_cpu_features": { "const": ["neon"] },
            "runtime_floor": { "$ref": "#/$defs/androidFloor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["triple", "os", "arch", "abi", "cpu_baseline", "required_cpu_features", "runtime_floor"],
          "properties": {
            "triple": { "const": "x86_64-linux-android" },
            "os": { "const": "android" },
            "arch": { "const": "x86_64" },
            "abi": { "const": "android" },
            "cpu_baseline": { "const": "x86-64-v1" },
            "required_cpu_features": { "const": ["cmov", "sse2"] },
            "runtime_floor": { "$ref": "#/$defs/androidFloor" }
          }
        }
      ]
    },
    "androidFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["android_api"],
      "properties": {
        "android_api": { "const": "26" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rustc", "compiler", "sdk", "linker"],
      "properties": {
        "rustc": { "$ref": "#/$defs/nonPlaceholder" },
        "compiler": { "$ref": "#/$defs/nonPlaceholder" },
        "sdk": { "$ref": "#/$defs/nonPlaceholder" },
        "linker": { "$ref": "#/$defs/nonPlaceholder" }
      }
    },
    "v8Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "rusty_v8_version", "rusty_v8_revision", "v8_revision", "normalized_gn_args", "patches"],
      "properties": {
        "backend": { "const": "v8" },
        "rusty_v8_version": { "$ref": "#/$defs/nonPlaceholder" },
        "rusty_v8_revision": { "$ref": "#/$defs/revision" },
        "v8_revision": { "$ref": "#/$defs/revision" },
        "normalized_gn_args": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonPlaceholder" }
        },
        "patches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/patch" }
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/nonPlaceholder" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_kind", "product_profile", "target_triple", "arch", "schema", "generator", "generation_cpu_policy", "normalized_parameters", "external_references_hash", "bootstrap_inputs_hash", "bytes_hash"],
      "properties": {
        "runtime_kind": { "enum": ["host", "worker"] },
        "product_profile": { "enum": ["full", "slim"] },
        "target_triple": { "$ref": "#/$defs/nonPlaceholder" },
        "arch": { "enum": ["aarch64", "x86_64"] },
        "schema": { "$ref": "#/$defs/nonPlaceholder" },
        "generator": { "$ref": "#/$defs/nonPlaceholder" },
        "generation_cpu_policy": { "const": "target-baseline" },
        "normalized_parameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonPlaceholder" }
        },
        "external_references_hash": { "$ref": "#/$defs/sha256" },
        "bootstrap_inputs_hash": { "$ref": "#/$defs/sha256" },
        "bytes_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "graphics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_family", "required_api"],
      "properties": {
        "backend_family": { "$ref": "#/$defs/nonPlaceholder" },
        "required_api": { "$ref": "#/$defs/nonPlaceholder" }
      }
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_binary", "v8_archive", "rust_binding", "cxx_runtime"],
      "properties": {
        "runtime_binary": { "$ref": "#/$defs/sha256" },
        "v8_archive": { "$ref": "#/$defs/sha256" },
        "rust_binding": { "$ref": "#/$defs/sha256" },
        "cxx_runtime": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "build_recipe", "build_recipe_sha256", "licenses"],
      "properties": {
        "source_revision": { "$ref": "#/$defs/revision" },
        "build_recipe": { "$ref": "#/$defs/nonPlaceholder" },
        "build_recipe_sha256": { "$ref": "#/$defs/sha256" },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonPlaceholder" }
        }
      }
    }
  }
}
