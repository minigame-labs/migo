# Rust
/target
**/target
**/*.rs.bk
Cargo.lock
# ...except the application/tool lockfiles, which are committed so builds are
# reproducible. CI runs these with `--locked`, which fails outright when the
# lockfile is missing.
!engine/Cargo.lock
!tools/artifact-manifest/Cargo.lock

# Build outputs
*.aar
*.apk
*.so
*.dylib
*.dll

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

.claude/
.worktrees/

# Environment
.env
.env.local
.env.*.local

# Node (if used for tooling)
node_modules/

# OS
Thumbs.db
.DS_Store

# Android
*.iml
.gradle/
local.properties
/build
/captures
.externalNativeBuild/
.cxx/

# Temporary
*.tmp
*.temp
AI_PROJECT_OVERVIEW.md

!docs/

# Python bytecode from the packaging scripts
__pycache__/
*.pyc

# Staged Linux SDK package (scripts/build-linux-sdk.sh output)
dist/

# Linux SDK V8 archive: a build product of scripts/build-v8-linux.sh.
# Not tracked -- the repo's LFS quota is already exhausted, and the script plus
# component-manifest.json reproduce and describe it.
engine/third_party/rusty_v8/x86_64-linux-gnu/librusty_v8.a
