--- a/build/rust/gni_impl/run_bindgen.py
+++ b/build/rust/gni_impl/run_bindgen.py
@@ -10,6 +10,15 @@
 import subprocess
 import sys

+# Remove ALL BINDGEN_EXTRA_CLANG_ARGS* vars (including target-suffixed
+# ones like BINDGEN_EXTRA_CLANG_ARGS_AARCH64_LINUX_ANDROID). They are set
+# for rusty_v8's own top-level binding.cc bindgen, but must not leak into
+# V8's internal bindgen here: V8 passes complete clang flags already, and
+# a leaked target override causes "unsupported option '-msse3' for target
+# 'aarch64-linux-android'" when host tools are built with --target=x86_64.
+for _k in [k for k in os.environ if k.startswith("BINDGEN_EXTRA_CLANG_ARGS")]:
+    del os.environ[_k]
+
 # Set up path to be able to import action_helpers.
 sys.path.append(
     os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir,
