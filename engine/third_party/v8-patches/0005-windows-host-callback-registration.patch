+// Returns 1 if `name` matched a slot, 0 otherwise. A 0 means the host and this
+// DLL disagree about the callback set and must be treated as fatal -- carrying
+// on would leave a null slot to be called later.
+extern "C" int v8__register_host_callback(const char* name, void* fn) {
+  if (name == nullptr || fn == nullptr) return 0;
+  for (const HostCallbackSlot& entry : kHostCallbackSlots) {
+    if (std::strcmp(entry.name, name) == 0) {
+      std::memcpy(entry.slot, &fn, sizeof fn);
+      return 1;
+    }
+  }
+  return 0;
+}
+
+// Returns 1 once every slot is bound. The host calls this after registering and
+// before initialising V8, so a callback added upstream but not yet supplied by
+// the host fails immediately instead of at the first serialization.
+extern "C" int v8__host_callbacks_ready(void) {
+  for (const HostCallbackSlot& entry : kHostCallbackSlots) {
+    void* bound = nullptr;
+    std::memcpy(&bound, entry.slot, sizeof bound);
+    if (bound == nullptr) return 0;
+  }
+  return 1;
+}
